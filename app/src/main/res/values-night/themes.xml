<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Without a night variant the window is light in both modes, and a dark-mode launch flashes
         white before Compose draws. The splash is the icon's ink, so the icon's own background
         disappears into it and only the mark shows. -->
    <style name="Theme.Deposplit" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
    </style>
</resources>
